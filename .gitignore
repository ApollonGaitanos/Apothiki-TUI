/target

# makepkg's working directories. This is why the PKGBUILD lives in packaging/
# rather than the repository root: makepkg uses ./src as its build directory and
# `makepkg -C` removes it, which at the root would delete the Rust sources.
/packaging/src/
/packaging/pkg/
/packaging/*.tar.gz
/packaging/*.pkg.tar.zst
/packaging/*.log

# Local development guidance for coding agents. Not part of the program, not
# useful to anyone installing it, and not something to publish.
/CLAUDE.md
/.claude/
/AGENTS.md

# Bug-report screenshots of a real desktop: app lists, Steam library, home
# paths. Useful while debugging, not something to publish.
/screenshots/

# A clone of this repository made inside itself, which `makepkg -si` from the
# README's clone instructions leaves behind. git add -A will otherwise commit
# it as a gitlink.
/Apothiki-TUI/
